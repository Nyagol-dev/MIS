# Copy this file to .env.local and replace every CHANGE_ME value.
# For a local PostgreSQL instance only, PGSSLMODE=disable is appropriate.
DATABASE_URL_APP=postgresql://mis_app:CHANGE_ME@127.0.0.1:5432/mis
DATABASE_URL_ADMIN=postgresql://mis_admin:CHANGE_ME@127.0.0.1:5432/mis
PGSSLMODE=disable

# Generate independently with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=CHANGE_ME_generate_at_least_32_random_characters
BILLING_ENCRYPTION_KEY=CHANGE_ME_base64_encoded_32_byte_key
CRON_SECRET=CHANGE_ME_generate_a_separate_random_secret

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional payment integrations. Leave unset until provider credentials exist.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# MPESA_CALLBACK_TOKEN=
# MPESA_IP_ALLOWLIST_ENFORCE=true
